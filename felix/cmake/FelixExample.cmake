set(FELIX_PART "xcvp1552-vsva3340-2MHP-e-S" CACHE STRING "FELIX FPGA part")
get_filename_component(FELIX_REPO_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." REALPATH)

macro(felix_example_setup)
  option(SLASH_USE_REPO "Build against the local repo tree instead of installed packages" OFF)
  if(SLASH_USE_REPO)
    list(APPEND CMAKE_MODULE_PATH "${FELIX_REPO_ROOT}/cmake")
    include(SlashTools)
    set(VRT_INCLUDE_VRTD ON CACHE BOOL "" FORCE)
    set(VRTD_INCLUDE_LIBSLASH ON CACHE BOOL "" FORCE)
    add_subdirectory(${FELIX_REPO_ROOT}/vrt ${CMAKE_CURRENT_BINARY_DIR}/vrt)
    set(_VRT_LIBS vrt)
  else()
    find_package(vrt REQUIRED CONFIG)
    find_package(SlashTools REQUIRED)
    set(_VRT_LIBS vrt::vrt)
  endif()
  set(DEVICE "${FELIX_PART}" CACHE STRING "Target device")
endmacro()

function(felix_retarget_hls)
  cmake_parse_arguments(FRH "" "SRC;OUT_ROOT" "KERNELS" ${ARGN})
  set(_dst "${CMAKE_CURRENT_BINARY_DIR}/hls_src")
  file(MAKE_DIRECTORY "${_dst}")
  foreach(k IN LISTS FRH_KERNELS)
    configure_file("${FRH_SRC}/${k}.cpp" "${_dst}/${k}.cpp" COPYONLY)
    file(READ "${FRH_SRC}/${k}.cfg" _cfg)
    string(REGEX REPLACE "(^|\n)part=[^\n]*" "\\1part=${FELIX_PART}" _cfg "${_cfg}")
    file(WRITE "${_dst}/${k}.cfg" "${_cfg}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${FRH_SRC}/${k}.cpp" "${FRH_SRC}/${k}.cfg")
  endforeach()
  set(${FRH_OUT_ROOT} "${_dst}" PARENT_SCOPE)
endfunction()
