 project-spec/meta-user/conf/user-rootfsconfig |  1 +
 .../felix-to-slash/felix-to-slash.bb          | 10 ++++
 .../felix-to-slash/files/felix-to-slash       | 54 +++++++++++++++++++
 .../recipes-core/busybox/busybox_%.bbappend   |  2 +
 .../recipes-core/busybox/files/devmem.cfg     |  1 +
 6 files changed, 69 insertions(+)
