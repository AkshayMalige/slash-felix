diff --git a/project-spec/meta-user/recipes-apps/felix-to-slash/felix-to-slash.bb b/project-spec/meta-user/recipes-apps/felix-to-slash/felix-to-slash.bb
new file mode 100644
index 0000000..b577983
--- /dev/null
+++ b/project-spec/meta-user/recipes-apps/felix-to-slash/felix-to-slash.bb
@@ -0,0 +1,10 @@
+SUMMARY = "Reboot the whole Versal from another SD boot file (FELIX to SLASH switch)"
+LICENSE = "CLOSED"
+SRC_URI = "file://felix-to-slash"
+S = "${WORKDIR}"
+RDEPENDS:${PN} = "busybox"
+do_install() {
+	install -d ${D}${bindir}
+	install -m 0755 ${WORKDIR}/felix-to-slash ${D}${bindir}/felix-to-slash
+}
+FILES:${PN} += "${bindir}/felix-to-slash"
diff --git a/project-spec/meta-user/recipes-apps/felix-to-slash/files/felix-to-slash b/project-spec/meta-user/recipes-apps/felix-to-slash/files/felix-to-slash
new file mode 100755
index 0000000..dfa89ce
--- /dev/null
+++ b/project-spec/meta-user/recipes-apps/felix-to-slash/files/felix-to-slash
@@ -0,0 +1,54 @@
+#!/bin/sh
+MULTI_BOOT_REG=0xF1110004
+target=0xF0000000
+delay=3
+status_only=0
+
+usage() {
+	echo "usage: felix-to-slash [-m MULTI_BOOT] [-d DELAY_S] [-s]"
+	echo "  default: MULTI_BOOT 0xF0000000 (BOOT.BIN = SLASH), system reboot in 3 s"
+	echo "  -m 0xF000000N  boot BOOT000N.BIN instead"
+	echo "  -s             only show MULTI_BOOT and the reboot scope"
+}
+
+while getopts "m:d:sh" o; do
+	case "$o" in
+		m) target=$OPTARG ;;
+		d) delay=$OPTARG ;;
+		s) status_only=1 ;;
+		*) usage; exit 2 ;;
+	esac
+done
+
+scope_file=""
+for f in /sys/devices/platform/firmware:*/shutdown_scope /sys/firmware/zynqmp/shutdown_scope; do
+	[ -w "$f" ] && { scope_file=$f; break; }
+done
+
+cur=$(devmem $MULTI_BOOT_REG 32) || { echo "FELIX_TO_SLASH: FAIL cannot read MULTI_BOOT"; exit 1; }
+echo "MULTI_BOOT now $cur"
+if [ -n "$scope_file" ]; then
+	echo "reboot scope ($scope_file): $(cat $scope_file)"
+else
+	echo "reboot scope: no shutdown_scope file found"
+fi
+[ "$status_only" = 1 ] && exit 0
+
+case "$delay" in ''|*[!0-9]*) echo "FELIX_TO_SLASH: FAIL bad delay '$delay'"; exit 2 ;; esac
+[ -n "$scope_file" ] || { echo "FELIX_TO_SLASH: FAIL no shutdown_scope, reboot would not reset the chip"; exit 1; }
+
+devmem $MULTI_BOOT_REG 32 "$target"
+rb=$(devmem $MULTI_BOOT_REG 32)
+if [ $((rb)) -ne $((target)) ]; then
+	echo "FELIX_TO_SLASH: FAIL MULTI_BOOT readback $rb, wanted $target"
+	exit 1
+fi
+echo system > "$scope_file"
+case "$(cat $scope_file)" in
+	*"[system]"*) ;;
+	*) echo "FELIX_TO_SLASH: FAIL reboot scope is $(cat $scope_file)"; exit 1 ;;
+esac
+
+logger -t felix-to-slash "MULTI_BOOT $rb, system reboot in $delay s"
+setsid sh -c "sleep $delay; sync; reboot" </dev/null >/dev/null 2>&1 &
+echo "FELIX_TO_SLASH: ARMED MULTI_BOOT $rb, system reboot in $delay s"
